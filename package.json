{
  "name": "mcp-winuae-emu",
  "version": "1.0.0",
  "description": "MCP server for debugging Amiga 68k programs in WinUAE via GDB RSP protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-winuae-emu": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test:adf-matrix": "npm run build && node scripts/a-mcp-01-matrix.mjs",
    "test:amiga-input": "node dist/amiga-automation-input-selftest.js",
    "test:conditional-breakpoint": "node dist/conditional-breakpoint-selftest.js",
    "test:hunk": "node dist/amiga-hunk-selftest.js",
    "test:bitmap": "node dist/bitmap-decode-selftest.js",
    "test:snapshot-live": "npm run build && node scripts/a-mcp-02-live.mjs",
    "test:pattern": "node dist/memory-pattern-search-selftest.js",
    "test:session": "node dist/winuae-session-selftest.js",
    "test:snapshot": "node dist/machine-snapshot-selftest.js",
    "watch": "tsc --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "winuae",
    "amiga",
    "68k",
    "m68k",
    "emulator",
    "debugging",
    "gdb",
    "retro",
    "commodore"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axewater/mcp-winuae-emu.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
